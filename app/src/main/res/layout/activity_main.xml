<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fundo_tela">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Comunicador Local"
            android:textColor="#263238"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="Escolha como deseja se conectar"
            android:textColor="#546E7A"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnModoBluetooth"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Bluetooth"
            android:textSize="18sp"
            android:backgroundTint="#1976D2" />

        <Button
            android:id="@+id/btnModoWifi"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Wi-Fi Direct"
            android:textSize="18sp"
            android:backgroundTint="#EF6C00" />

        <TextView
            android:id="@+id/tvVersao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="#607D8B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="© mmquasetudo · Desenvolvedor: Moises20XX\nSoftware livre e gratuito"
            android:textColor="#607D8B"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
